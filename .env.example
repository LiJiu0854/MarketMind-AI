APP_NAME=MarketMind AI
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8010
LOG_LEVEL=INFO
DATABASE_URL=
TEST_DATABASE_URL=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000
RESEARCH_MAX_ACTIONS=4
RESEARCH_MAX_EVIDENCE=12
# RAG 文件仅存本机；MySQL 保存业务状态，Chroma 保存可重建的向量索引。
KNOWLEDGE_FILE_ROOT=data/knowledge
KNOWLEDGE_MAX_FILE_BYTES=10485760
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.35
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
# Embedding 可独立于 Chat 选择提供商；改模型或维度后须新建知识库并重新上传索引。
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=64
REDIS_PASSWORD=replace-with-local-secret
REDIS_URL=redis://:replace-with-local-secret@127.0.0.1:6379/0
TEST_REDIS_URL=redis://:replace-with-local-secret@127.0.0.1:6379/15
REDIS_CACHE_TTL_SECONDS=60
IDEMPOTENCY_PROCESSING_TTL_SECONDS=30
IDEMPOTENCY_RESULT_TTL_SECONDS=86400
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
REDIS_LOCK_TTL_MS=30000
CELERY_BROKER_URL=redis://:replace-with-local-secret@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-local-secret@127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_RESULT_EXPIRES_SECONDS=3600
