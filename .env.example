APP_NAME=MarketMind AI
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8010
LOG_LEVEL=INFO
DATABASE_URL=
TEST_DATABASE_URL=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000
REDIS_PASSWORD=replace-with-local-secret
REDIS_URL=redis://:replace-with-local-secret@127.0.0.1:6379/0
TEST_REDIS_URL=redis://:replace-with-local-secret@127.0.0.1:6379/15
REDIS_CACHE_TTL_SECONDS=60
IDEMPOTENCY_PROCESSING_TTL_SECONDS=30
IDEMPOTENCY_RESULT_TTL_SECONDS=86400
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
REDIS_LOCK_TTL_MS=30000
CELERY_BROKER_URL=redis://:replace-with-local-secret@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-local-secret@127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_RESULT_EXPIRES_SECONDS=3600
